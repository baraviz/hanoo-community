      ]
    }
  ],
  "whatsapp_greeting": "\u05e9\u05dc\u05d5\u05dd! \ud83d\udc4b \u05d0\u05e0\u05d9 \u05d4\u05e1\u05d5\u05db\u05df \u05d4\u05d7\u05db\u05dd \u05e9\u05dc Hanoo.\n\n\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da:\n\ud83c\udd7f\ufe0f \u05dc\u05d7\u05e4\u05e9 \u05d7\u05e0\u05d9\u05d5\u05ea \u05e4\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05d1\u05e0\u05d9\u05d9\u05df \u05e9\u05dc\u05da\n\ud83d\udcc5 \u05dc\u05d4\u05d6\u05de\u05d9\u05df \u05d7\u05e0\u05d9\u05d4\n\u274c \u05dc\u05d1\u05d8\u05dc \u05d4\u05d6\u05de\u05e0\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea\n\ud83d\udccb \u05dc\u05e8\u05d0\u05d5\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05e9\u05dc\u05da\n\n\u05de\u05d4 \u05ea\u05e8\u05e6\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea?"
}