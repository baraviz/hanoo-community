{
  "name": "ReferralEvent",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "referrer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "building_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d1\u05e0\u05d9\u05d9\u05df \u05d1\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "link_opened",
        "joined"
      ],
      "description": "link_opened=\u05e4\u05ea\u05d7 \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8, joined=\u05d4\u05e6\u05d8\u05e8\u05e3 \u05d3\u05e8\u05db\u05d5"
    },
    "new_resident_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05d7\u05d3\u05e9 (\u05e8\u05e7 \u05d0\u05dd event_type=joined)"
    }
  },
  "required": [
    "referrer_email",
    "building_id",
    "event_type"
  ]
}