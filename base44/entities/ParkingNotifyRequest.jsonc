{
  "name": "ParkingNotifyRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e7\u05e9 \u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05dcSMS"
    },
    "building_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d1\u05e0\u05d9\u05d9\u05df"
    },
    "from_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e6\u05e8\u05d9\u05da \u05d4\u05d7\u05e0\u05d9\u05d4 \u05de-"
    },
    "to_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e6\u05e8\u05d9\u05da \u05d4\u05d7\u05e0\u05d9\u05d4 \u05e2\u05d3"
    },
    "notified": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05db\u05d1\u05e8 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d4\u05ea\u05e8\u05d0\u05d4"
    }
  },
  "required": [
    "user_email",
    "building_id",
    "from_time",
    "to_time"
  ]
}